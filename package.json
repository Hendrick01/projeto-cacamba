{
  "name": "cacamba",
  "version": "0.1.0",
  "description": "Caçamba — jogo de cartas multiplayer para celular (7 rodadas de contratos com trincas e sequências)",
  "type": "module",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "test": "node --test \"test/**/*.test.js\"",
    "dev": "node server.js",
    "test:integration": "node test/integration.mjs",
    "test:security": "node test/security-live.mjs",
    "test:contas": "node test/contas-live.mjs",
    "db:migra": "node -e \"import('./lib/banco.js').then(m=>m.migra().then(ok=>{console.log(ok?'esquema aplicado':'sem DATABASE_URL');return m.fecha()}))\"",
    "test:webhook": "node test/webhook-live.mjs",
    "test:reinicio": "node test/reinicio.mjs",
    "test:presidente": "node test/presidente.mjs",
    "test:domino": "node test/domino.mjs",
    "test:bazuca": "node test/bazuca.mjs",
    "test:poker": "node test/poker.mjs",
    "test:puxadinho": "node test/puxadinho.mjs",
    "test:mexemexe": "node test/mexemexe.mjs",
    "test:canastra": "node test/canastra.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "postgres": "^3.4.9",
    "qrcode": "^1.5.4",
    "ws": "^8.21.3"
  }
}
